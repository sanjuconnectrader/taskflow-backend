DATABASE_URL=postgresql://postgres:REPLACE_LOCAL_PASSWORD@localhost:5432/taskflow?schema=public
# Optional Supabase configuration. Keep real credentials only in ignored .env files.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&schema=taskflow&sslmode=verify-full&sslrootcert=prod-ca-2021.crt
# DIRECT_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?schema=taskflow&sslmode=verify-full&sslrootcert=prod-ca-2021.crt
# TEST_DATABASE_URL=postgresql://postgres:REPLACE_LOCAL_PASSWORD@localhost:5432/taskflow_test?schema=public
PORT=4000
NODE_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4173,https://localhost,http://localhost,taskflow://app
API_PUBLIC_URL=http://localhost:4000
APP_WEB_ORIGIN=http://localhost:3000
# Production: use api.example.com and app.example.com for reliable cookie sessions.
COOKIE_SAME_SITE=lax
# Private S3-compatible storage (optional until file uploads are enabled)
STORAGE_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=taskflow-files
# Optional for private GitHub release repositories; public releases need no token.
GITHUB_RELEASE_READ_TOKEN=
# Free-tier limits and cleanup settings can be changed for paid plans.
DATABASE_LIMIT_BYTES=500000000
STORAGE_LIMIT_BYTES=1000000000
STORAGE_UPLOAD_CEILING_PERCENT=95
TEMP_UPLOAD_RETENTION_HOURS=24
RETENTION_EXPIRED_SESSIONS_DAYS=1
RETENTION_EXPIRED_RESET_DAYS=7
# Zero disables automatic removal of these potentially important records.
RETENTION_READ_NOTIFICATIONS_DAYS=0
RETENTION_ACTIVITY_DAYS=0
RETENTION_AUDIT_DAYS=0
REMINDERS_INTERVAL_MINUTES=60
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
